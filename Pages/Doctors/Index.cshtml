@page
@model ClinicBooking.Web.Pages.Doctors.IndexModel
@{
    ViewData["Title"] = "Dottori";
}
<h2>Dottori</h2>

<p>
    <a class="btn btn-primary" asp-page="Create">Nuovo Dottore</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefono</th>
            <th>Specializzazioni</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.List)
        {
            <tr>
                <td>@r.Name</td>
                <td>@r.Email</td>
                <td>@r.Phone</td>
                <td>@r.Specs</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@r.DoctorId">Modifica</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@r.DoctorId">Elimina</a>
                </td>
            </tr>
        }
    </tbody>
</table>