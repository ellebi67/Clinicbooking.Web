@page "{id:int}"
@model ClinicBooking.Web.Pages.Doctors.DeleteModel
@{
    ViewData["Title"] = "Elimina dottore";
}
<h2>Elimina dottore</h2>
<p class="text-danger">Confermi l'eliminazione?</p>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Item!.Name</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Item!.Email</dd>
    <dt class="col-sm-2">Telefono</dt>
    <dd class="col-sm-10">@Model.Item!.Phone</dd>
</dl>

<form method="post">
    <button class="btn btn-danger">Elimina</button>
    <a class="btn btn-secondary" asp-page="Index">Indietro</a>
</form>