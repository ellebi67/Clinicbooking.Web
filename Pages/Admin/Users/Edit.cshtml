@page "{id}"
@model ClinicBooking.Web.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Modifica utente";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <form method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" value="@Model.Email" disabled />
            <div class="form-text">Lo username coincide con l'email ed è bloccato in modifica.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Ruoli</label>
            <select asp-for="SelectedRoles" class="form-select" multiple size="4" asp-items="Model.AllRoles"></select>
            <small class="form-text text-muted">CTRL/⌘ per selezione multipla.</small>
        </div>

        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2">Reimposta password (opzionale)</legend>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </fieldset>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salva</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Annulla</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
