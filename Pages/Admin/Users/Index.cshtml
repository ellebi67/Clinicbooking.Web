@page
@model ClinicBooking.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Gestione Utenti";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1>@ViewData["Title"]</h1>
            <p class="text-muted">Gestione utenti del sistema - Solo per Amministratori</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <!-- Pulsante per aggiungere nuovo utente -->
            <a class="btn btn-success" asp-page="Create">
                <i class="bi bi-plus-circle"></i> Nuovo Utente
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <!-- Tabella utenti esistenti -->
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Email</th>
                        <th>Ruoli</th>
                        <th>Stato</th>
                        <th>Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>
                                <!-- Badge colorati per i ruoli -->
                                @foreach (var role in user.Roles.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                            </td>
                            <td>
                                <!-- Badge per stato attivo/disabilitato -->
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Attivo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Disabilitato</span>
                                }
                            </td>
                            <td>
                                <!-- Pulsanti azioni con logica condizionale -->
                                <a class="btn btn-sm btn-outline-primary @(user.IsProtected ? "disabled pe-none" : "")"
                                    asp-page="Edit" asp-route-id="@user.Id"
                                    aria-disabled="@(user.IsProtected ? "true" : "false")"
                                    tabindex="@(user.IsProtected ? "-1" : "0")"
                                    title="@(user.IsProtected ? "Utente protetto: ruoli non modificabili" : "Modifica utente")">
                                    Modifica
                                </a>

                                @if (user.IsActive)
{
    <a class="btn btn-sm btn-outline-warning @(user.IsProtected ? "disabled pe-none" : "")"
       asp-page="Disable" asp-route-id="@user.Id"
       aria-disabled="@(user.IsProtected ? "true" : "false")"
       tabindex="@(user.IsProtected ? "-1" : "0")"
       title="@(user.IsProtected ? "Utente protetto: non può essere disabilitato" : "Disabilita utente")">
        Disabilita
    </a>
}
else
{
    <a class="btn btn-sm btn-outline-success @(user.IsProtected ? "disabled pe-none" : "")"
       asp-page="Enable" asp-route-id="@user.Id"
       aria-disabled="@(user.IsProtected ? "true" : "false")"
       tabindex="@(user.IsProtected ? "-1" : "0")"
       title="@(user.IsProtected ? "Utente protetto: non può essere riabilitato" : "Abilita utente")">
        Abilita
    </a>
}
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>