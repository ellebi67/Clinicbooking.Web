@page
@model ClinicBooking.Web.Pages.Bookings.MyAppointmentsModel
@using ClinicBooking.Web.Models
@{
    ViewData["Title"] = "Miei Appuntamenti";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1>I miei appuntamenti di oggi</h1>
            <p class="text-muted">Dott. @Model.DoctorName - @Model.Today.ToString("dddd, dd MMMM yyyy")</p>
        </div>
    </div>

    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.TodayAppointments.Count == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center">
                    <h4>Nessun appuntamento oggi</h4>
                    <p>Non hai appuntamenti programmati per oggi.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <!-- Tabella appuntamenti del dottore -->
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Ora</th>
                            <th>Paziente</th>
                            <th>Specializzazione</th>
                            <th>Note</th>
                            <th>Stato</th>
                            <th>Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.TodayAppointments)
                        {
                            <tr>
                                <td>
                                    <strong>@booking.BookingTime.ToString("HH:mm")</strong>
                                </td>
                                <td>
                                    <i class="bi bi-person"></i> @booking.Patient?.Name
                                    @if (!string.IsNullOrEmpty(booking.Patient?.Phone))
                                    {
                                        <br>
                            
                                        <small class="text-muted">Tel: @booking.Patient.Phone</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@booking.Specialization?.Name</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(booking.Notes))
                                    {
                                        <small>@booking.Notes</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <!-- Badge stato con colori -->
                                    @switch (booking.Status)
                                    {
                                        case BookingStatus.Scheduled:
                                            <span class="badge bg-secondary">Programmata</span>
                                            break;
                                        case BookingStatus.Confirmed:
                                            <span class="badge bg-primary">Confermata</span>
                                            break;
                                        case BookingStatus.Completed:
                                            <span class="badge bg-success">Eseguita</span>
                                            break;
                                        case BookingStatus.Cancelled:
                                            <span class="badge bg-danger">Annullata</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <!-- Pulsanti azioni basati su stato corrente -->
                                    <form method="post" asp-page-handler="UpdateStatus" class="d-inline">
                                        <input type="hidden" name="bookingId" value="@booking.BookingId" />

                                        @if (booking.Status == BookingStatus.Scheduled)
                                        {
                                            <!-- Da Programmata: può confermare o annullare -->
                                            <button name="newStatus" value="Confirmed" class="btn btn-sm btn-outline-success me-1">
                                                Conferma
                                            </button>
                                            <button name="newStatus" value="Cancelled" class="btn btn-sm btn-outline-danger">
                                                Annulla
                                            </button>
                                        }
                                        else if (booking.Status == BookingStatus.Confirmed)
                                        {
                                            <!-- Da Confermata: può completare o annullare -->
                                            <button name="newStatus" value="Completed" class="btn btn-sm btn-outline-info me-1">
                                                Eseguita
                                            </button>
                                            <button name="newStatus" value="Cancelled" class="btn btn-sm btn-outline-danger">
                                                Annulla
                                            </button>
                                        }
                                        else
                                        {
                                            <!-- Stati finali: nessuna azione disponibile -->
                                            <span class="text-muted small">Completato</span>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>