@page "{id:int}"
@model ClinicBooking.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Elimina Appuntamento";
}

<div class="container mt-4">
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <hr />

    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">
            <i class="bi bi-exclamation-triangle"></i> Attenzione!
        </h4>
        <p class="mb-0">
            Stai per eliminare definitivamente questo appuntamento.
            <strong>Questa operazione non può essere annullata.</strong>
        </p>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Dettagli Appuntamento da Eliminare</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Data e Ora</dt>
                        <dd class="col-sm-9">
                            <strong class="text-primary">
                                @Model.Booking.DateTime.ToString("dddd, dd MMMM yyyy")
                            </strong>
                            <br />
                            <span class="badge bg-info">
                                Ore @Model.Booking.DateTime.ToString("HH:mm")
                            </span>
                        </dd>

                        <dt class="col-sm-3">Paziente</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-person"></i> @Model.Booking.Patient?.Name
                            @if (!string.IsNullOrEmpty(Model.Booking.Patient?.Email))
                            {
                                <br />
                                <small class="text-muted">
                                    <i class="bi bi-envelope"></i> @Model.Booking.Patient.Email
                                </small>
                            }
                        </dd>

                        <dt class="col-sm-3">Dottore</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-hospital"></i> Dr. @Model.Booking.Doctor?.Name
                        </dd>

                        <dt class="col-sm-3">Specializzazione</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-success">
                                @Model.Booking.Specialization?.Name
                            </span>
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Booking.Notes))
                        {
                            <dt class="col-sm-3">Note</dt>
                            <dd class="col-sm-9">
                                <div class="alert alert-secondary mb-0">
                                    @Model.Booking.Notes
                                </div>
                            </dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="mt-4">
                <form method="post">
                    <input type="hidden" name="id" value="@Model.Booking.BookingId" />

                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-trash"></i> Conferma Eliminazione
                    </button>

                    <a asp-page="Index" class="btn btn-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> Annulla
                    </a>

                    <a asp-page="Edit" asp-route-id="@Model.Booking.BookingId" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-pencil"></i> Modifica Invece
                    </a>
                </form>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0">
                        <i class="bi bi-info-circle"></i> Informazioni
                    </h6>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        <strong>Cosa succede quando elimini?</strong>
                    </p>
                    <ul class="small">
                        <li>L'appuntamento viene rimosso definitivamente</li>
                        <li>I dati del paziente, dottore e specializzazione restano intatti</li>
                        <li>L'operazione non può essere annullata</li>
                        <li>Considera di modificare invece di eliminare se serve solo cambiare data/ora</li>
                    </ul>
                </div>
            </div>

            <div class="card border-info mt-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-lightbulb"></i> Suggerimento
                    </h6>
                </div>
                <div class="card-body">
                    <p class="card-text small mb-0">
                        Se l'appuntamento deve essere spostato o i dettagli devono essere corretti,
                        usa il pulsante <strong>"Modifica Invece"</strong> per aggiornarlo senza perdere lo storico.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Conferma prima dell'eliminazione
        document.querySelector('form').addEventListener('submit', function (e) {
            const confirmed = confirm(
                'Sei ASSOLUTAMENTE SICURO di voler eliminare questo appuntamento?\n\n' +
                'Paziente: @Model.Booking.Patient?.Name\n' +
                'Data: @Model.Booking.DateTime.ToString("dd/MM/yyyy HH:mm")\n' +
                'Dottore: Dr. @Model.Booking.Doctor?.Name\n\n' +
                'Questa azione NON può essere annullata!'
            );

            if (!confirmed) {
                e.preventDefault();
            }
        });
    </script>
}