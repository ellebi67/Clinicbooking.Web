@page
@model ClinicBooking.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Nuovo Appuntamento";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Paziente -->
                <div class="mb-3">
                    <label asp-for="Booking.PatientId" class="form-label">
                        Paziente <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Booking.PatientId" class="form-select" asp-items="Model.PatientsSelectList">
                        <option value="0">-- Seleziona un paziente --</option>
                    </select>
                    <span asp-validation-for="Booking.PatientId" class="text-danger"></span>
                </div>

                <!-- Dottore -->
                <div class="mb-3">
                    <label asp-for="Booking.DoctorId" class="form-label">
                        Dottore <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Booking.DoctorId" class="form-select" asp-items="Model.DoctorsSelectList"
                        id="doctorSelect">
                        <option value="0">-- Seleziona un dottore --</option>
                    </select>
                    <span asp-validation-for="Booking.DoctorId" class="text-danger"></span>
                </div>

                <!-- Specializzazione (filtrata dinamicamente in base al dottore selezionato) -->
                <div class="mb-3">
                    <label asp-for="Booking.SpecializationId" class="form-label">
                        Specializzazione <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Booking.SpecializationId" class="form-select" id="specializationSelect"
                        disabled="@(Model.Booking?.DoctorId > 0 ? null : "disabled")">
                        <option value="0">-- Prima seleziona un dottore --</option>
                    </select>
                    <span asp-validation-for="Booking.SpecializationId" class="text-danger"></span>
                    <div class="form-text">
                        Verranno mostrate solo le specializzazioni del dottore selezionato
                    </div>
                </div>

                <!-- Data e Ora -->
                <div class="mb-3">
                    <label asp-for="Booking.DateTime" class="form-label">
                        Data e Ora <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Booking.DateTime" class="form-control" type="datetime-local"
                        min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" step="1800" />
                    <span asp-validation-for="Booking.DateTime" class="text-danger"></span>
                    <div class="form-text">
                        Non è possibile selezionare date passate
                    </div>
                </div>

                <!-- Note (opzionale) -->
                <div class="mb-3">
                    <label asp-for="Booking.Notes" class="form-label">Note</label>
                    <textarea asp-for="Booking.Notes" class="form-control" rows="4"
                        placeholder="Inserisci eventuali note sull'appuntamento (opzionale)"></textarea>
                    <span asp-validation-for="Booking.Notes" class="text-danger"></span>
                </div>

                <!-- Pulsanti -->
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Crea Appuntamento
                    </button>
                    <a asp-page="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Annulla
                    </a>
                </div>
            </form>
        </div>

        <!-- Colonna info (opzionale) -->
        <div class="col-md-6">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle"></i> Informazioni
                    </h5>
                    <ul class="mb-0">
                        <li>Seleziona prima il <strong>paziente</strong></li>
                        <li>Poi scegli il <strong>dottore</strong></li>
                        <li>Le <strong>specializzazioni</strong> verranno filtrate automaticamente in base al dottore
                        </li>
                        <li>La data proposta parte da oggi</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // JavaScript per il caricamento dinamico delle specializzazioni
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Script caricato'); // Verifica che lo script parta
            const doctorSelect = document.getElementById('doctorSelect'); // ID corretto del dropdown dottore
            const specializationSelect = document.getElementById('specializationSelect'); // ID corretto del dropdown specializzazioni

            console.log('doctorSelect:', doctorSelect); // Verifica se trova l'elemento
            console.log('specializationSelect:', specializationSelect); // Verifica se trova l'elemento

            // Se uno dei due è null, stampa tutti gli ID disponibili
            if (!doctorSelect || !specializationSelect) {
                console.log('ID disponibili nella pagina:');
                document.querySelectorAll('select').forEach(select => {
                    console.log('Select trovata:', select.id, select.name);
                });
                return; // Ferma l'esecuzione se non trova gli elementi
            }

            // Event listener sul cambio del dottore
            doctorSelect.addEventListener('change', async function () {
                const doctorId = this.value; // Ottiene il valore del dottore selezionato

                // Reset dropdown specializzazioni con messaggio di caricamento
                specializationSelect.innerHTML = '<option value="0">-- Caricamento... --</option>';
                specializationSelect.disabled = true; // Disabilita durante il caricamento

                // Se non è stato selezionato nessun dottore
                if (!doctorId || doctorId === "0") {
                    specializationSelect.innerHTML = '<option value="0">-- Prima seleziona un dottore --</option>';
                    return;
                }

                try {
                    // Chiamata AJAX al PageHandler per ottenere specializzazioni del dottore
                    const response = await fetch(`?handler=SpecializationsByDoctor&doctorId=${doctorId}`);

                    if (!response.ok) {
                        throw new Error('Errore nel caricamento delle specializzazioni');
                    }

                    const specializations = await response.json(); // Converte risposta in JSON

                    // Svuota il dropdown e aggiungi opzione predefinita
                    specializationSelect.innerHTML = '<option value="0">-- Seleziona una specializzazione --</option>';

                    // Popola con le specializzazioni del dottore
                    if (specializations.length > 0) {
                        specializations.forEach(spec => {
                            const option = document.createElement('option'); // Crea elemento option
                            option.value = spec.id; // Imposta valore ID specializzazione
                            option.textContent = spec.name; // Imposta testo visualizzato
                            specializationSelect.appendChild(option); // Aggiunge al dropdown
                        });
                        specializationSelect.disabled = false; // Riabilita il dropdown
                    } else {
                        specializationSelect.innerHTML = '<option value="0">Questo dottore non ha specializzazioni</option>';
                    }

                } catch (error) {
                    console.error('Errore nel caricamento delle specializzazioni:', error);
                    specializationSelect.innerHTML = '<option value="0">Errore nel caricamento</option>';
                    alert('Si è verificato un errore nel caricamento delle specializzazioni. Riprova.');
                }
            });
        });
    </script>

}