@page "{id:int}"
@model ClinicBooking.Web.Pages.Specializations.DeleteModel
@{
    ViewData["Title"] = "Elimina specializzazione";
}
<h2>Elimina specializzazione</h2>
<p class="text-danger">Confermi l'eliminazione?</p>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Item.Name</dd>
</dl>

<form method="post">
    <button class="btn btn-danger">Elimina</button>
    <a class="btn btn-secondary" asp-page="Index">Indietro</a>
</form>