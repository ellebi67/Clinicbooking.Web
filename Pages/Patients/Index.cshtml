@page
@model ClinicBooking.Web.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Pazienti";
}
<h2>Pazienti</h2>

<p><a class="btn btn-primary" asp-page="Create">Nuovo Paziente</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefono</th>
            <th>Codice Fiscale</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.List)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Email</td>
                <td>@p.Phone</td>
                <td>@p.TaxCode</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@p.PatientId">Dettagli</a>
                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@p.PatientId">Modifica</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@p.PatientId">Elimina</a>

                </td>
            </tr>
        }
    </tbody>
</table>