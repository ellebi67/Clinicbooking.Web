@page "{id:int}"
@model ClinicBooking.Web.Pages.Patients.EditModel
@{
    ViewData["Title"] = "Modifica Paziente";
}
<h2>Modifica Paziente</h2>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Input.PatientId" />
    <input type="hidden" asp-for="Input.RowVersion" />

    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">Nome</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Phone" class="form-label">Telefono</label>
        <input asp-for="Input.Phone" class="form-control" />
        <span asp-validation-for="Input.Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.TaxCode" class="form-label">Codice Fiscale</label>
        <input asp-for="Input.TaxCode" class="form-control" />
        <span asp-validation-for="Input.TaxCode" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Salva</button>
    <a class="btn btn-secondary" asp-page="Index">Annulla</a>
    <a class="btn btn-secondary" asp-page="Index">Annulla</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}