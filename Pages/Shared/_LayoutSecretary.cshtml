<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicBooking.Web [Secretary]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/secretary-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicBooking.Web.styles.css" asp-append-version="true" />


</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-3"
            style="background-color: #2c5f8d !important; border: none;">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"
                    style="color: white !important;">ClinicBooking.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Patients/Index" style="color: white !important;">
                                👤 Pazienti
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Specializations/Index" style="color: white !important;">
                                🏥 Specializzazioni
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Doctors/Index" style="color: white !important;">
                                👨‍⚕️ Dottori
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Bookings/Index" style="color: white !important;">
                                📅 Appuntamenti
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Agenda/Agenda" style="color: white !important;">
                                📆 Agenda
                            </a>
                        </li>

                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - ClinicBooking.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>